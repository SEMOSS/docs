{
  "tags": [
    "Engine Execution"
  ],
  "description": "Executes a Pixel expression and returns the full result in the response.",
  "operationId": "runPixelSync",
  "x-codeSamples": [
    {
      "lang": "JavaScript",
      "label": "SEMOSS SDK",
    "source": "const { actions } = useInsight();\nconst ask = (question) => {\nconst { pixelReturn } = await actions.run(\n    ${usage};\n\n// get the message\nconst message = pixelReturn[0].output.response;\nconsole.log(message);\n};\n"
    },
    {
      "lang": "Python",
      "label": "SEMOSS SDK",
      "source": "from semoss import Insight\ninsight = Insight(insight_id = '${i}')\ninsight.run_pixel(\"${usage}\")\n"
    }
  ],
  "requestBody": {
    "content": {
      "application/x-www-form-urlencoded": {
        "schema": {
          "required": [
            "expression"
          ],
          "type": "object",
          "properties": {
            "dropLogging": {
              "type": "boolean",
              "description": "If true, drop console logging after run",
              "example": true
            },
            "expression": {
              "type": "string",
              "description": "expression=${usage}",
              "example": "expression=${usage}"
            },
            "insightId": {
              "type": "string",
              "description": "Insight identifier. Use 'new' to create a new insight or omit for temporary.",
              "example": "bf235853-86b7-483f-a0a5-ae489bfed97b"
            },
            "tz": {
              "type": "string",
              "description": "Client timezone ID",
              "example": "America/New_York"
            }
          },
          "title": "RunPixelRequest"
        }
      }
    },
    "required": true
  },
  "responses": {
    "200": {
      "description": "Pixel executed",
      "content": {
        "application/json": {
          "schema": {
            "type": "object",
            "example": {
              "status": "success",
              "data": {
                "result": "Pixel execution output"
              }
            }
          },
          "examples": {
            "Sample Response": {
              "description": "Sample Response",
              "value": {
                "status": "success",
